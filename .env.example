# Copie a .env y complete lo que tenga. Nunca suba .env al repositorio.
# Sin una clave, la pieza que la usa corre en modo simulado o por reglas, y lo dice.
DATABASE_URL=sqlite:///data/brujula.db
TZ=America/Bogota
# URL pública del servidor (webhooks de Dapta y de correo), p. ej. un túnel
PUBLIC_BASE_URL=http://localhost:8000

# Dapta: clave MCP creada en el panel ("MCP Access"); agente de voz, secuencia y agente de texto (los crea `python cli.py dapta-setup`)
DAPTA_API_KEY=
DAPTA_MCP_URL=https://mcp.dapta.ai/mcp
DAPTA_AGENT_ID=
DAPTA_SEQUENCE_ID=
DAPTA_TEXT_AGENT_ID=

# Agente de texto: Bedrock si la cuenta lo tiene habilitado (BEDROCK=1); si no, OpenAI; si no, Amazon Nova por OpenRouter; si no, reglas
BEDROCK=1
BEDROCK_MODEL=us.anthropic.claude-haiku-5-5
AWS_REGION=us-east-1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_OPENROUTER_MODEL=amazon/nova-lite-v1

# Jev (TypeSafe) vía OpenRouter: puntúa el cliente ideal y clasifica respuestas. Sin clave, solo reglas.
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.14

# Correo: brevo | ses | resend. Sin clave, el canal correo se simula.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
RESEND_API_KEY=
# entre comillas: deploy.sh lo carga con bash
EMAIL_FROM="Brújula <hola@su-dominio.com>"

# Modo prueba: el ciclo corre con leads reales, pero la llamada va a TELEFONO_PRUEBA y el correo a CORREOS_PRUEBA (coma). Nunca a un tercero.
MODO_PRUEBA=0
TELEFONO_PRUEBA=
CORREOS_PRUEBA=

# Cognito (sin estas variables el servidor corre abierto, para desarrollo local)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
SESSION_SECRET=

# Servidor
# clave que exigen /cron/lote y /cron/sincronizar
CRON_KEY=
CORS_ORIGINS=*
# bucket S3 para subidas y exportaciones; vacío = disco local
EXPORT_BUCKET=

# Fuentes (opcionales)
# más cuota en datos.gov.co
SOCRATA_APP_TOKEN=
# DENUE del INEGI (México)
DENUE_TOKEN=
