# Copie a .env y complete. Nunca suba .env al repositorio.
DATABASE_URL=sqlite:///data/brujula.db
TZ=America/Bogota

# Dapta (clave MCP creada en el panel de Dapta, "MCP Access"; amarra un workspace)
DAPTA_API_KEY=
DAPTA_MCP_URL=https://mcp.dapta.ai/mcp
DAPTA_AGENT_ID=
DAPTA_SEQUENCE_ID=

# Jev (TypeSafe) vía OpenRouter. Si falta, el ICP se puntúa solo con reglas.
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.14

# Correo (Resend) o SES. Si faltan, el canal correo corre en modo simulado.
RESEND_API_KEY=
EMAIL_FROM=Brújula <hola@su-dominio.com>

# URL pública del servidor (webhooks de Dapta y de correo), p. ej. un túnel.
PUBLIC_BASE_URL=http://localhost:8000

# Opcionales
SOCRATA_APP_TOKEN=
DENUE_TOKEN=
