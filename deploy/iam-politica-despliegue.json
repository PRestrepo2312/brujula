{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Identidad",
      "Effect": "Allow",
      "Action": ["sts:GetCallerIdentity"],
      "Resource": "*"
    },
    {
      "Sid": "ImagenEnECR",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken", "ecr:CreateRepository", "ecr:DescribeRepositories", "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload", "ecr:UploadLayerPart", "ecr:CompleteLayerUpload", "ecr:PutImage", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PilaCloudFormation",
      "Effect": "Allow",
      "Action": ["cloudformation:*"],
      "Resource": "arn:aws:cloudformation:*:*:stack/brujula/*"
    },
    {
      "Sid": "RecursosDeLaPila",
      "Effect": "Allow",
      "Action": [
        "apprunner:*", "rds:*", "secretsmanager:*", "s3:*", "events:*", "ec2:DescribeVpcs", "ec2:DescribeSubnets",
        "ec2:DescribeSecurityGroups", "ec2:CreateSecurityGroup", "ec2:DeleteSecurityGroup", "ec2:AuthorizeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupIngress", "ec2:CreateTags", "logs:*", "ses:*", "sns:*", "route53:*", "cloudfront:*", "acm:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RolesQueCreaLaPila",
      "Effect": "Allow",
      "Action": ["iam:CreateRole", "iam:DeleteRole", "iam:GetRole", "iam:PassRole", "iam:AttachRolePolicy", "iam:DetachRolePolicy",
                 "iam:PutRolePolicy", "iam:DeleteRolePolicy", "iam:GetRolePolicy", "iam:TagRole", "iam:CreateServiceLinkedRole"],
      "Resource": "*"
    }
  ]
}
